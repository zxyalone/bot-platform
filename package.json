{
  "name": "bot-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/daemon/main.ts",
    "demo": "node --disable-warning=ExperimentalWarning test/demo-daemon.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-force-exit --test-timeout=60000 --test-reporter=spec test/unit/*.test.ts",
    "test:live": "node --disable-warning=ExperimentalWarning --test --test-force-exit --test-reporter=spec test/live/*.test.ts"
  },
  "bin": { "botctl": "bin/botctl.mjs" }
}
